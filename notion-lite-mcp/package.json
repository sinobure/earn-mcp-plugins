{
  "name": "notion-lite-mcp",
  "version": "1.1.0",
  "description": "Lightweight MCP server for searching, reading, and appending to Notion pages via the official Notion API",
  "type": "module",
  "bin": {
    "notion-lite-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/server.js",
    "dist/server.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "ai",
    "claude",
    "llm",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "notion",
    "notion-api",
    "notion-mcp"
  ],
  "author": {
    "name": "Kento Watarai",
    "url": "https://github.com/sinobure"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinobure/earn-mcp-plugins.git",
    "directory": "notion-lite-mcp"
  },
  "bugs": {
    "url": "https://github.com/sinobure/earn-mcp-plugins/issues"
  },
  "homepage": "https://github.com/sinobure/earn-mcp-plugins/tree/main/notion-lite-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
