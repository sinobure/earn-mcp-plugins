{
  "name": "fx-rate-mcp",
  "version": "1.0.0",
  "description": "MCP server for real-time exchange rates using open.er-api.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fx-rate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "mcp-server",
    "exchange-rate",
    "currency",
    "forex",
    "fx",
    "claude",
    "ai"
  ],
  "author": "Kento Watarai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinobure/earn-mcp-plugins.git",
    "directory": "exchange-rate-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/sinobure/earn-mcp-plugins/issues"
  },
  "homepage": "https://github.com/sinobure/earn-mcp-plugins/tree/main/exchange-rate-mcp#readme"
}
