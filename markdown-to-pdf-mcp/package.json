{
  "name": "md2pdf-mcp",
  "version": "1.0.0",
  "description": "MCP server for converting Markdown to print-optimized HTML (PDF via browser Ctrl+P). No API key required.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "md2pdf-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "mcp",
    "markdown",
    "pdf",
    "html",
    "print",
    "modelcontextprotocol",
    "md2pdf"
  ],
  "author": "Kento Watarai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kento-Watarai/earn-mcp-plugins.git",
    "directory": "markdown-to-pdf-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
