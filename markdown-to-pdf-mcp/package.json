{
  "name": "md2pdf-mcp",
  "version": "1.0.0",
  "description": "MCP server that converts Markdown to print-optimized A4 HTML (not a PDF: save as PDF via browser Ctrl+P). No API key required.",
  "type": "module",
  "bin": {
    "md2pdf-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lib.js",
    "dist/lib.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "tsc -p tsconfig.build.json && vitest run"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "markdown",
    "pdf",
    "html",
    "print",
    "a4",
    "modelcontextprotocol",
    "md2pdf"
  ],
  "author": {
    "name": "Kento Watarai",
    "url": "https://github.com/sinobure"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinobure/earn-mcp-plugins.git",
    "directory": "markdown-to-pdf-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/sinobure/earn-mcp-plugins/issues"
  },
  "homepage": "https://github.com/sinobure/earn-mcp-plugins/tree/main/markdown-to-pdf-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
