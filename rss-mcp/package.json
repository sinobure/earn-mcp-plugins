{
  "name": "kw-rss-mcp",
  "version": "1.0.0",
  "description": "MCP server for fetching and searching RSS/Atom feeds without any API key",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kw-rss-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "mcp",
    "rss",
    "atom",
    "feed",
    "modelcontextprotocol",
    "rss-reader"
  ],
  "author": "Kento Watarai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kento-Watarai/earn-mcp-plugins.git",
    "directory": "rss-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
