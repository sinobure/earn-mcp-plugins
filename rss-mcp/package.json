{
  "name": "kw-rss-mcp",
  "version": "1.0.0",
  "description": "MCP server for fetching and searching RSS/Atom feeds without any API key",
  "type": "module",
  "bin": {
    "kw-rss-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "rss",
    "atom",
    "feed",
    "modelcontextprotocol",
    "rss-reader",
    "rdf",
    "mcp-server",
    "claude"
  ],
  "author": {
    "name": "Kento Watarai",
    "url": "https://github.com/sinobure"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinobure/earn-mcp-plugins.git",
    "directory": "rss-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/sinobure/earn-mcp-plugins/issues"
  },
  "homepage": "https://github.com/sinobure/earn-mcp-plugins/tree/main/rss-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
