{
  "name": "kw-time-mcp",
  "version": "1.0.0",
  "description": "MCP server providing current time, timezone conversion, duration arithmetic, and Japanese holiday lookup — no API key required",
  "type": "module",
  "bin": {
    "kw-time-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lib.js",
    "dist/lib.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "time",
    "timezone",
    "holiday",
    "japanese-holiday",
    "modelcontextprotocol",
    "claude",
    "mcp-server",
    "datetime",
    "dst",
    "japan",
    "holidays"
  ],
  "author": {
    "name": "Kento Watarai",
    "url": "https://github.com/sinobure"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinobure/earn-mcp-plugins.git",
    "directory": "time-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/sinobure/earn-mcp-plugins/issues"
  },
  "homepage": "https://github.com/sinobure/earn-mcp-plugins/tree/main/time-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
